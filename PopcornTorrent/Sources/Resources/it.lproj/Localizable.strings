/* (No Commment) */
"File doesn't exist at path: %@" = "Il file non esiste al percorso: %1$@";

/* (No Commment) */
"There is not enough space to download the torrent. Please clear at least %@ and try again." = "Non c'è abbastanza spazio per scaricare il torrent. Cancella almeno %1$@ e riprova.";

/* (No Commment) */
"Could not create download directory" = "Impossibile creare la cartella di download";


/* (No Commment) */
"There is not enough space to stream this video, even with limited storage. Please clear at least %@ and try again." = "Non c'è abbastanza spazio per riprodurre questo video, nemmeno con lo spazio limitato. Cancella almeno %1$@ e riprova.";

/* A stream cannot start: the same torrent is already streamed (in a way that cannot be shared) or downloaded. */
"This video is already being played or downloaded. Stop the other playback or the download, then try again." = "Questo video è già in riproduzione o in download. Interrompi l'altra riproduzione o il download, poi riprova.";
"Another episode of this torrent is being downloaded. Try again once that download is finished, or delete it." = "È in corso il download di un altro episodio di questo torrent. Riprova al termine di quel download, oppure eliminalo.";

/* A stream that was reading the file of an offline download of the same torrent stops: the download was stopped before the file was complete. */
"This video was playing from its download, and the download was stopped." = "Questo video veniva riprodotto dal suo download, e il download è stato interrotto.";

/* Bounded storage: the volume stayed full while the video was loading; the space this video itself held is given back when it stops. */
"There is not enough free space to start this video. Please clear some space and try again." = "Non c’è abbastanza spazio libero per avviare questo video. Libera dello spazio e riprova.";

/* A stream or download fails before downloading anything: the torrent (e.g. a season pack) does not hold the episode that was asked for. */
"This torrent does not contain the requested episode. Please choose another source." = "Questo torrent non contiene l’episodio richiesto. Scegli un’altra fonte.";
