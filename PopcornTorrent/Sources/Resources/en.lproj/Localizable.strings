
/* File doesn't exist at path: {Path to file} */
"File doesn't exist at path: %@" = "File doesn't exist at path: %1$@";

/* There is not enough space to download the torrent. Please clear at least {Amount of space required for the user to remove} and try again. */
"There is not enough space to download the torrent. Please clear at least %@ and try again." = "There is not enough space to download the torrent. Please clear at least %1$@ and try again.";

"Could not create download directory" = "Could not create download directory";

/* Bounded storage cannot start. {Amount of space the user has to free} */
"There is not enough space to stream this video, even with limited storage. Please clear at least %@ and try again." = "There is not enough space to stream this video, even with limited storage. Please clear at least %1$@ and try again.";

/* A stream cannot start: the same torrent is already streamed (in a way that cannot be shared) or downloaded. */
"This video is already being played or downloaded. Stop the other playback or the download, then try again." = "This video is already being played or downloaded. Stop the other playback or the download, then try again.";
"Another episode of this torrent is being downloaded. Try again once that download is finished, or delete it." = "Another episode of this torrent is being downloaded. Try again once that download is finished, or delete it.";

/* A stream that was reading the file of an offline download of the same torrent stops: the download was stopped before the file was complete. */
"This video was playing from its download, and the download was stopped." = "This video was playing from its download, and the download was stopped.";

/* Bounded storage: the volume stayed full while the video was loading; the space this video itself held is given back when it stops. */
"There is not enough free space to start this video. Please clear some space and try again." = "There is not enough free space to start this video. Please clear some space and try again.";

/* A stream or download fails before downloading anything: the torrent (e.g. a season pack) does not hold the episode that was asked for. */
"This torrent does not contain the requested episode. Please choose another source." = "This torrent does not contain the requested episode. Please choose another source.";
