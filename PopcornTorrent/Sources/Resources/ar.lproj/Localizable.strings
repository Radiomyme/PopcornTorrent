/* (No Commment) */
"There is not enough space to download the torrent. Please clear at least %@ and try again." = "لا يوجد مساحة كافية لتحميل التورنت. الرجاء تنظيف آخر %1$@ وحاول مجدداً";

/* (No Commment) */
"Could not create download directory" = "لا يمكن إنشاء تحميل مباشر";


/* (No Commment) */
"There is not enough space to stream this video, even with limited storage. Please clear at least %@ and try again." = "لا توجد مساحة كافية لتشغيل هذا الفيديو حتى مع التخزين المحدود. الرجاء تنظيف %1$@ على الأقل وحاول مجدداً";

/* A stream cannot start: the same torrent is already streamed (in a way that cannot be shared) or downloaded. */
"This video is already being played or downloaded. Stop the other playback or the download, then try again." = "هذا الفيديو قيد التشغيل أو التنزيل بالفعل. أوقف التشغيل الآخر أو التنزيل، ثم حاول مجدداً.";
"Another episode of this torrent is being downloaded. Try again once that download is finished, or delete it." = "يجري تنزيل حلقة أخرى من هذا التورنت. أعد المحاولة بعد انتهاء ذلك التنزيل، أو احذفه.";

/* A stream that was reading the file of an offline download of the same torrent stops: the download was stopped before the file was complete. */
"This video was playing from its download, and the download was stopped." = "كان هذا الفيديو يُشغَّل من التنزيل الخاص به، وقد تم إيقاف التنزيل.";

/* Bounded storage: the volume stayed full while the video was loading; the space this video itself held is given back when it stops. */
"There is not enough free space to start this video. Please clear some space and try again." = "لا توجد مساحة خالية كافية لبدء هذا الفيديو. أخلِ بعض المساحة ثم حاول مجدداً.";

/* A stream or download fails before downloading anything: the torrent (e.g. a season pack) does not hold the episode that was asked for. */
"This torrent does not contain the requested episode. Please choose another source." = "لا يحتوي هذا التورنت على الحلقة المطلوبة. اختر مصدرًا آخر.";
